<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  Evidence (photos, clips, sensor data) is stored on-device and, when enabled,
	  in the user's OWN private CloudKit database — the developer cannot access it.
	  Under Apple's definition that is not "data collection", so this is empty.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- Required-reason APIs the app uses. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info stored in defaults, accessible only to this app. -->
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!--
				  35F9.1: measure elapsed time between events that occur inside the app.
				  KeychainService uses ProcessInfo.systemUptime as the brute-force lockout
				  clock precisely because it is monotonic and cannot be rewound by changing
				  the device clock — the whole point of the lockout.
				-->
				<string>35F9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!--
				  C617.1: timestamps of files inside the app's own container. CameraController
				  reads contentModificationDate to sweep orphaned clips, and EventStore stats
				  media files for the retention byte cap. No file outside the container is
				  touched.
				-->
				<string>C617.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
